{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "AIStock 交易监控",
  "uid": "aistock-trading",
  "version": 1,
  "schemaVersion": 36,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "服务状态",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "订单提交速率",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "showPoints": "auto" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(atrading_orders_total[5m])) by (action)", "legendFormat": "{{action}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "总资产 / 当日盈亏",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" },
          "unit": "currencyCNY"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "atrading_total_equity", "legendFormat": "总资产", "refId": "A" },
        { "expr": "atrading_pnl_daily", "legendFormat": "当日盈亏", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "持仓市值",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" },
          "unit": "currencyCNY"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "atrading_positions_value", "legendFormat": "持仓市值", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "交易信号速率",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "showPoints": "auto" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(atrading_signals_total[5m])) by (action)", "legendFormat": "{{action}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI 当日费用 (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "atrading_ai_cost_daily", "legendFormat": "AI费用", "refId": "A" }
      ]
    }
  ]
}
