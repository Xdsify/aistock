# ============================================
# AI全自动炒股系统 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================

# --- 数据库 ---
DB_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql://aistock:${DB_PASSWORD}@postgres:5432/aistock

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 券商 (华泰 miniQMT) ---
BROKER_ACCOUNT=your_account_number
BROKER_PASSWORD=your_trade_password
XTQUANT_PATH=C:/xtquant      # miniQMT安装路径 (Windows)

# --- Tushare (备用数据源) ---
TUSHARE_TOKEN=your_tushare_token

# --- JWT ---
JWT_SECRET=generate_a_random_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123        # 生产环境务必修改

# --- Grafana ---
GRAFANA_PASSWORD=admin_password

# --- 交易时段 ---
ENFORCE_TRADING_HOURS=true    # true=闭市拒绝下单; false=随时可下单(便于学习测试)

# --- 风控参数 ---
MAX_SINGLE_STOCK_PCT=0.20     # 单股最大仓位 20%
MAX_SECTOR_PCT=0.40           # 单行业最大仓位 40%
DAILY_LOSS_LIMIT_PCT=0.05     # 日亏损上限 5%
MAX_DRAWDOWN_PCT=0.08         # 最大回撤 8%
AI_CONFIDENCE_THRESHOLD=0.6   # AI信号最低置信度

# --- AI预算 ---
AI_DAILY_TOKEN_BUDGET=1000000 # 每日Token预算(约$0.3/天)
AI_MAX_RPM=30                 # 每分钟最大请求数
